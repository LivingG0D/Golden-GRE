# Real per-host tunnel configs live in /etc/golden-gre on each server — never here.
*.conf
!sysctl/*.conf

# Secrets / credentials — never commit.
.env
*.key
*.crt
*.pem
*.pub
id_rsa*
secrets*
known_hosts

# Editor / OS cruft
*.swp
*~
.DS_Store
Thumbs.db

# Benchmark: the two servers' real addresses and raw logs never go in the repository.
bench/hosts.env
results/raw/
